    "express": "^4.19.2",
    "preact": "^10.22.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "store": "^2.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "babel-loader": "^9.1.3",
